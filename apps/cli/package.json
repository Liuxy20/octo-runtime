    "@mininglamp-oss/octo-runtime-cross-service": "workspace:*",
    "@mininglamp-oss/octo-runtime-protocol": "workspace:*",
    "@mininglamp-oss/octo-runtime-executor-kernel": "workspace:*",
    "@mininglamp-oss/octo-runtime-executor-core": "workspace:*",
    "@mininglamp-oss/octo-runtime-adapter-antigravity": "workspace:*",
    "@mininglamp-oss/octo-runtime-adapter-claude-code": "workspace:*",
    "@mininglamp-oss/octo-runtime-adapter-codebuddy": "workspace:*",
    "@mininglamp-oss/octo-runtime-adapter-codex": "workspace:*",

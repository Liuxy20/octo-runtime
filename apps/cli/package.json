    "@mininglamp-oss/octo-runtime-adapter-zcode-gui": "workspace:*",
    "@mininglamp-oss/octo-runtime-extra-channel-wecom": "workspace:*",
    "@mininglamp-oss/octo-runtime-extra-webui": "workspace:*"
  }

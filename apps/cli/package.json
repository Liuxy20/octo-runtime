    "@mininglamp-oss/octo-runtime-adapter-mcode": "workspace:*",
    "@mininglamp-oss/octo-runtime-adapter-opencode": "workspace:*",
    "@mininglamp-oss/octo-runtime-adapter-qodercli": "workspace:*",

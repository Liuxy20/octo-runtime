{
  "version": 1,
  "adapters": [
    {
      "type": "dsh",
      "module": "@mininglamp-oss/octo-runtime-adapter-dsh",
      "export": "dshAdapter"
    },
    {
      "type": "codex",
      "module": "@mininglamp-oss/octo-runtime-adapter-codex",
      "export": "codexAdapter"
    },
    {
      "type": "claude-code",
      "module": "@mininglamp-oss/octo-runtime-adapter-claude-code",
      "export": "claudeCodeAdapter"
    },
    {
      "type": "codebuddy",
      "module": "@mininglamp-oss/octo-runtime-adapter-codebuddy",
      "export": "codebuddyAdapter"
    },
    {
      "type": "grok-build",
      "module": "@mininglamp-oss/octo-runtime-adapter-grok-build",
      "export": "grokBuildAdapter"
    },
    {
      "type": "hermes",
      "module": "@mininglamp-oss/octo-runtime-adapter-hermes",
      "export": "hermesAdapter"
    },
    {
      "type": "kimi-code",
      "module": "@mininglamp-oss/octo-runtime-adapter-kimi-code",
      "export": "kimiCodeAdapter"
    },
    {
      "type": "mcode",
      "module": "@mininglamp-oss/octo-runtime-adapter-mcode",
      "export": "mcodeAdapter"
    },
    {
      "type": "opencode",
      "module": "@mininglamp-oss/octo-runtime-adapter-opencode",
      "export": "opencodeAdapter"
    },
    {
      "type": "openclaw",
      "module": "@mininglamp-oss/octo-runtime-adapter-openclaw",
      "export": "openclawAdapter"
    },
    {
      "type": "qodercli",
      "module": "@mininglamp-oss/octo-runtime-adapter-qodercli",
      "export": "qoderCliAdapter"
    },
    {
      "type": "qoderclicn",
      "module": "@mininglamp-oss/octo-runtime-adapter-qoderclicn",
      "export": "qoderCliCnAdapter"
    },
    {
      "type": "zcode-gui",
      "module": "@mininglamp-oss/octo-runtime-adapter-zcode-gui",
      "export": "zcodeGuiAdapter"
    },
    {
      "type": "antigravity",
      "module": "@mininglamp-oss/octo-runtime-adapter-antigravity",
      "export": "antigravityAdapter"
    }
  ],
  "extras": [
    {
      "name": "channel-gateway",
      "description": "Connect Octo IM Bots to local Agent execution",
      "configExample": {
        "bots": [
          {
            "api_url": "https://im.example.com/api",
            "bot_id": "<BOT_ID>",
            "bf_token": "<BOT_TOKEN>",
            "adapter": {
              "adapter_type": "codex",
              "workdir": "/absolute/workspace",
              "model": "<MODEL_ID>",
              "effort": "medium"
            }
          }
        ]
      },
      "module": "@mininglamp-oss/octo-runtime-extra-channel-gateway"
    },
    {
      "name": "channel-wecom",
      "description": "Connect WeCom Bots to local Agent execution",
      "configExample": {
        "bots": [
          {
            "bot_id": "<BOT_ID>",
            "app_secret": "<APP_SECRET>",
            "adapter": {
              "adapter_type": "codex",
              "workdir": "/absolute/workspace",
              "model": "<MODEL_ID>",
              "effort": "medium"
            }
          }
        ]
      },
      "module": "@mininglamp-oss/octo-runtime-extra-channel-wecom"
    },
    {
      "name": "webui",
      "description": "Open a local browser workspace for Agent conversations",
      "configExample": {
        "port": 13888,
        "sessionStorePath": "/absolute/host-home/extras/webui/sessions.json"
      },
      "module": "@mininglamp-oss/octo-runtime-extra-webui"
    }
  ]
}

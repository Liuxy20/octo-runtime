{
  "schema": "octo.context-envelope/v3",
  "items": [
    {
      "namespace": "octo.execution",
      "name": "adapter",
      "payload": {
        "type": "codex"
      }
    },
    {
      "namespace": "octo.execution",
      "name": "model",
      "payload": {
        "reasoning": {
          "effort": "medium"
        }
      }
    },
    {
      "namespace": "octo.execution",
      "name": "workspace",
      "payload": {
        "path": "/example/project"
      }
    },
    {
      "namespace": "octo.execution",
      "name": "envs",
      "payload": {
        "env_variables": [
          {
            "key": "PROJECT_ID",
            "value": "example-project"
          }
        ]
      }
    },
    {
      "namespace": "octo.execution",
      "name": "mcp",
      "payload": {
        "mcpServers": {
          "project-docs": {
            "type": "streamable_http",
            "url": "https://example.com/mcp"
          }
        }
      }
    },
    {
      "namespace": "octo.execution",
      "name": "limits",
      "payload": {
        "run_timeout_ms": 120000
      }
    },
    {
      "namespace": "octo.security",
      "name": "approval_policy",
      "payload": {
        "mode": "ask"
      }
    }
  ]
}
